###
# Slurm cgroup support configuration file.
###
CgroupPlugin={{ CGROUP_CGROUPPLUGIN | default("autodetect", true) }}
ConstrainCores={{ CGROUP_CONSTRAINCORES | default("yes", true) }}
ConstrainDevices={{ CGROUP_CONSTRAINDEVICES | default("yes", true) }}
ConstrainRAMSpace={{ CGROUP_CONSTRAINRAMSPACE | default("yes", true) }}
ConstrainSwapSpace={{ CGROUP_CONSTRAINSWAPSPACE | default("no", true) }}
EnableControllers={{ CGROUP_ENABLECONTROLLERS | default("yes", true) }}
IgnoreSystemdOnFailure={{ CGROUP_IGNORESYSTEMDONFAILURE | default("yes", true) }}
